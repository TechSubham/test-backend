# Lyftr backend configuration. On Render set these in the dashboard; locally copy to .env.
# NEVER commit .env.

# Two DISTINCT Gemini API keys from two different Google Cloud projects (quota is per project).
LLM_API_KEYS=
LLM_MODEL=gemini/gemini-3.8-flash
# Optional; leave blank to use LLM_MODEL for every key, or provide one model per key.
LLM_KEY_MODELS=
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
MAX_HISTORY_MESSAGES=40

# Docker image default: sqlite:////data/app.db (mount a disk/volume at /data).
# Running without Docker: sqlite:///./data/app.db
DATABASE_URL=sqlite:////data/app.db

CACHE_TYPE=local
CACHE_TTL_SECONDS=86400

# Exact frontend origin(s), comma-separated, no trailing slash.
ALLOWED_ORIGINS=http://localhost:3000
# X-Simulate-Failure test hook — must be true on the deployed backend.
ENABLE_FAILURE_SIMULATION=true

LOG_LEVEL=INFO
APP_ENV=production
PORT=8000
