# Allow-list build context: only what backend/Dockerfile copies. Everything else — .env,
# keys, .venv, caches, SQLite files (*.db, -wal, -shm), tests, git metadata — stays out.
**
!requirements.txt
!app/
!app/**
!docker/
!docker/healthcheck.py
# Re-exclude generated files that may exist inside the re-included directories.
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/*.db
**/*.db-wal
**/*.db-shm
**/.env
**/.env.*
